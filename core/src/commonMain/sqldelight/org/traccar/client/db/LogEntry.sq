CREATE TABLE LogEntry (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    time INTEGER NOT NULL,
    message TEXT NOT NULL,
    level TEXT NOT NULL DEFAULT 'info'
);

CREATE INDEX LogEntry_level ON LogEntry(level, id);

insert:
INSERT INTO LogEntry(time, message, level) VALUES (?, ?, ?);

selectAll:
SELECT time, message, level
FROM LogEntry
ORDER BY id ASC;

selectRecent:
SELECT time, message, level
FROM LogEntry
ORDER BY id DESC
LIMIT :limit;

clear:
DELETE FROM LogEntry;

-- Trimming is per level on purpose: verbose entries must never evict the
-- main log, or turning detail on would destroy the history worth keeping.
trimLevel:
DELETE FROM LogEntry
WHERE level = :level
  AND id <= (SELECT MAX(id) - :keep FROM LogEntry WHERE level = :level);
